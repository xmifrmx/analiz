{
  "name": "firmware-scraper",
  "version": "2.1.0",
  "private": true,
  "description": "Multi-site firmware scraper. Curated to the 24 brands listed on https://immaculate.eu.cc/tr/markalar (Samsung, Xiaomi/Redmi, Huawei, Honor, Oppo, Vivo, Realme, OnePlus, Google, Motorola/Lenovo, Sony, Asus, Nokia, Tecno, Infinix, TCL, ZTE/Nubia, Meizu, General Mobile, Casper, Vestel) plus a naijarom.com Tools category (flashing tools/software, not a phone brand). Generates per-brand RSS feeds with direct download links.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "scrape": "node fetch_roms.js",
    "scrape:all": "node fetch_roms.js --depth 50 --out-dir ./feeds",
    "scrape:samsung": "node fetch_roms.js samsung --out-dir ./feeds",
    "scrape:xiaomi": "node fetch_roms.js xiaomi redmi --out-dir ./feeds",
    "scrape:huawei": "node fetch_roms.js huawei honor --out-dir ./feeds",
    "scrape:oppo": "node fetch_roms.js oppo --out-dir ./feeds",
    "scrape:vivo": "node fetch_roms.js vivo --out-dir ./feeds",
    "scrape:realme": "node fetch_roms.js realme --out-dir ./feeds",
    "scrape:oneplus": "node fetch_roms.js oneplus --out-dir ./feeds",
    "scrape:google": "node fetch_roms.js google --out-dir ./feeds",
    "scrape:motorola": "node fetch_roms.js motorola lenovo --out-dir ./feeds",
    "scrape:sony": "node fetch_roms.js sony --out-dir ./feeds",
    "scrape:asus": "node fetch_roms.js asus --out-dir ./feeds",
    "scrape:nokia": "node fetch_roms.js nokia --out-dir ./feeds",
    "scrape:tecno": "node fetch_roms.js tecno --out-dir ./feeds",
    "scrape:infinix": "node fetch_roms.js infinix --out-dir ./feeds",
    "scrape:tcl": "node fetch_roms.js tcl --out-dir ./feeds",
    "scrape:zte": "node fetch_roms.js zte nubia --out-dir ./feeds",
    "scrape:meizu": "node fetch_roms.js meizu --out-dir ./feeds",
    "scrape:gm": "node fetch_roms.js general-mobile --out-dir ./feeds",
    "scrape:casper": "node fetch_roms.js casper --out-dir ./feeds",
    "scrape:vestel": "node fetch_roms.js vestel --out-dir ./feeds",
    "scrape:tools": "node fetch_roms.js tools --out-dir ./feeds",
    "test": "echo \"Error: no test specified\" && exit 1"
  }
}
